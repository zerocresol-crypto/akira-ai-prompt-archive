{
  "name": "akira-ai-prompt-archive",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "test": "node --test test/*.test.js",
    "check:deploy": "node scripts/check-deploy.mjs",
    "db:verify": "wrangler d1 execute DB --remote --command \"SELECT name FROM sqlite_master WHERE type='table' ORDER BY name\""
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}

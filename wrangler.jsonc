{
  "name": "akira-ai-prompt-archive",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "prompt-archive-images" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prompt-archive",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
